{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(npm test)",
      "Bash(npm run build:html)",
      "Bash(node --check:*)",
      "Bash(python3 scripts/build_context.py)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./keystore.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)"
    ]
  }
}
