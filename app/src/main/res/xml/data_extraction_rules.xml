<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+). Inclui banco Room e preferências no backup da nuvem e na transferência
     direta entre aparelhos. Cópias manuais exportadas pelo seletor de arquivos não estão aqui:
     ficam onde o motorista escolher. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
